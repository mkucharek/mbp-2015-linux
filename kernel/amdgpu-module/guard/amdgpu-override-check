#!/bin/sh
# Guard for the patched amdgpu module, which only works with the kernel it was built for.
#   amdgpu-override-check           at boot: if the patched module isn't loaded, switch this boot
#                                   to s2idle, plain suspend on lid close and no hibernate, because
#                                   the stock module hangs on resume from deep sleep. Everything
#                                   goes under /run, so it resets at the next boot.
#   amdgpu-override-check --warn [kver]
#                                   after a kernel update: warn about kernels without the module
#                                   (all installed kernels, or only kver). --pacman is the same.
#   amdgpu-override-check --force   apply the fallback anyway (to test it; a reboot undoes it)
flag=/run/amdgpu-stock-module

has_override() { ls "/usr/lib/modules/$1/updates/"amdgpu.ko.* >/dev/null 2>&1; }

if [ "${1:-}" = --warn ] || [ "${1:-}" = --pacman ]; then
    for d in /usr/lib/modules/*/; do
        k=$(basename "$d")
        [ -n "${2:-}" ] && [ "$k" != "$2" ] && continue
        [ -e "$d/vmlinuz" ] || continue
        has_override "$k" && continue
        echo "WARNING: no patched amdgpu module for kernel $k."
        echo "  After rebooting into it, deep sleep and hibernate stay off until you build the module for it"
        echo "  (kernel/amdgpu-module: KVER=$k bash build-fedora.sh on Fedora, then sudo KVER=$k bash install.sh)."
    done
    exit 0
fi

# udev loads the GPU driver, possibly after this runs: wait up to 15 s for amdgpu or radeon
for _ in $(seq 30); do
    [ -d /sys/module/amdgpu ] || [ -d /sys/module/radeon ] && break
    sleep 0.5
done
# Not an amdgpu boot (e.g. radeon): nothing to guard
[ -d /sys/module/amdgpu ] || exit 0

kver=$(uname -r)
override=$(ls "/usr/lib/modules/$kver/updates/"amdgpu.ko.* 2>/dev/null | head -1)
patched_loaded() {
    [ -n "$override" ] || return 1
    if [ -e /sys/module/amdgpu/srcversion ]; then
        # Arch: every module has a srcversion, so compare it with the override's
        [ "$(modinfo -F srcversion "$override")" = "$(cat /sys/module/amdgpu/srcversion)" ]
    else
        # Fedora (no CONFIG_MODULE_SRCVERSION_ALL): the stock module is in-tree, the patched one
        # is out-of-tree, which shows as O in its taint flags
        grep -q O /sys/module/amdgpu/taint
    fi
}
if [ "${1:-}" != --force ] && patched_loaded; then
    exit 0
fi

echo "$kver" > "$flag"
echo s2idle > /sys/power/mem_sleep
# logind's lid action (Omarchy). On KDE, PowerDevil handles the lid and suspends through logind,
# which then uses the s2idle set above.
mkdir -p /run/systemd/logind.conf.d
printf '[Login]\nHandleLidSwitch=suspend\n' > /run/systemd/logind.conf.d/99-amdgpu-stock-module.conf
systemctl kill -s HUP systemd-logind 2>/dev/null || true
systemctl mask --runtime --quiet hibernate.target suspend-then-hibernate.target hybrid-sleep.target
echo "patched amdgpu module not loaded on $kver: s2idle, plain suspend on lid close, no hibernate for this boot"
